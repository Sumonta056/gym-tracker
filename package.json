{
  "name": "gym-tracker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=25 <26",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack && serwist build serwist.config.mjs",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "report": "node scripts/commit-report.ts",
    "db:link": "supabase link",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff --linked",
    "types:db": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > lib/supabase/database.types.ts && prettier --write lib/supabase/database.types.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lighthouse": "lhci autorun --config=./lighthouserc.json",
    "design:check": "node scripts/design-check.mjs",
    "design:check:staged": "node scripts/design-check.mjs --staged",
    "test:required": "node scripts/require-tests.mjs",
    "test:required:staged": "node scripts/require-tests.mjs --staged",
    "static": "pnpm format:check && pnpm lint --max-warnings=0 && pnpm typecheck && pnpm design:check && pnpm test:required",
    "verify": "pnpm static && pnpm test:cov && pnpm build && pnpm e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.88.0",
    "serwist": "^9.5.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "0.13.0",
    "@playwright/test": "^1.63.0",
    "@serwist/cli": "^9.5.12",
    "@serwist/next": "^9.5.12",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
