. "$(dirname "$0")/node-version.sh"

pnpm exec lint-staged
pnpm typecheck
pnpm design:check:staged
pnpm test:required:staged

# Skip instead of failing the commit when vitest is absent, for example on a fresh clone.
if [ -x node_modules/.bin/vitest ]; then
  STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' | tr '\n' ' ')
  if [ -n "$STAGED_TS" ]; then
    pnpm vitest related --run --passWithNoTests $STAGED_TS
  fi
else
  echo "pre-commit: vitest not installed yet, skipping related tests"
fi
